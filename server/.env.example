PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hotkb
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173

# OAuth (AUTH-01) — optionnel : un bouton n'apparaît que si le fournisseur est configuré.
# URL de rappel à déclarer chez le fournisseur : ${PUBLIC_URL}/api/auth/oauth/<github|discord>/callback
PUBLIC_URL=http://localhost:4000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
